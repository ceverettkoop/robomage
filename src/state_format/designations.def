// The designations: what a player, a permanent or the game itself is marked with, each declared
// once. A row is the state and its frame column together, so a new designation is one row here:
// it makes the field, the schema column (schema.cpp, at that row's place in its table) and the
// encoder's cell (encode.cpp), which the knowledge sidecar and the featurizer read by their tags
// and `make registry` gives a slot.
//
// What resets a row is where it lives. A Player is rebuilt each game and a Game is fresh each game
// (`GAME`), and a Permanent is built anew at each entry (CR 400.7), so its rows last as long as the
// object does; a player's `TURN` row is reset with the turn counts (Player::reset_turn_counters).
// All of them live in the ECS or in cur_game, so a snapshot holds them with no row of its own.
//
// A table's rows are one contiguous block of its columns, in this order: a row goes at its block's
// end, and reordering moves the frame's bytes.
//
//   DESIGNATION_TURN(type, field, init, column, storage, tag, read)
//       Game::field, a column of `turn`.
//   DESIGNATION_GAME_PLAYER(type, field, init, column, storage, tag, read)
//       Game::field, a column of `player`: read per player `pl` (their entity `pe`).
//   DESIGNATION_PLAYER(type, field, init, lasts, column, storage, tag, read)
//       Player::field, a column of `player`; `lasts` GAME or TURN.
//   DESIGNATION_OBJECT(type, field, init, column, storage, tag, of_card, none, read)
//       Permanent::field, a column of `object`: `read` over `perm`, `none` for an object that is no
//       permanent. `of_card` says it tells something of the card, so a viewer who can't see the
//       card reads `none` (docs/state_format.md §6).
//   DESIGNATION_OBJECT_COLUMN(column, storage, tag, of_card, none, read)
//       A column of `object` over state declared elsewhere.
//
// `storage` is a Storage's name and `tag` the column's tag. Includers define the macros they need;
// an undefined one expands to nothing.
#ifndef DESIGNATION_TURN
#define DESIGNATION_TURN(type, field, init, column, storage, tag, read)
#endif
#ifndef DESIGNATION_GAME_PLAYER
#define DESIGNATION_GAME_PLAYER(type, field, init, column, storage, tag, read)
#endif
#ifndef DESIGNATION_PLAYER
#define DESIGNATION_PLAYER(type, field, init, lasts, column, storage, tag, read)
#endif
#ifndef DESIGNATION_OBJECT
#define DESIGNATION_OBJECT(type, field, init, column, storage, tag, of_card, none, read)
#endif
#ifndef DESIGNATION_OBJECT_COLUMN
#define DESIGNATION_OBJECT_COLUMN(column, storage, tag, of_card, none, read)
#endif

// ── turn ─────────────────────────────────────────────────────────────────────────────────────────

// Day/Night designation the game itself can have (CR 731.1). Starts at "neither" and, once
// set, is always exactly one of day/night. Driven by the daybound/nightbound subsystem
// (src/day_night.*); read by day-/night-conditional effects. A fresh Game starts neither.
DESIGNATION_TURN(DayNight, day_night, DN_NEITHER, day_night, U8, "enum:day_night", cur_game.day_night)

// ── player ───────────────────────────────────────────────────────────────────────────────────────

// The monarch (CR 725). MAX_ENTITIES = no monarch (none until an effect makes a player
// the monarch).
DESIGNATION_GAME_PLAYER(Entity, monarch_entity, MAX_ENTITIES, monarch, U8, "bool", cur_game.monarch_entity == pe)
// 702.131c: city's blessing designation, kept for the rest of the game once obtained
DESIGNATION_PLAYER(bool, has_city_blessing, false, GAME, city_blessing, U8, "bool", pl.has_city_blessing)

// ── object ───────────────────────────────────────────────────────────────────────────────────────

// card name chosen on ETB (Disruptor Flute) — keys Card.NamedCard statics
DESIGNATION_OBJECT(std::string, chosen_name, "", chosen_name, U16, "card", true, NONE16,
                   perm->chosen_name.empty() ? NONE16 : card_or_none(card_name_to_index(perm->chosen_name)))
// creature type chosen on ETB (Cavern of Souls)
DESIGNATION_OBJECT(std::string, chosen_type, "", chosen_type, U16, "enum:subtype", true, NONE16, chosen_type_cell(*perm))
// CR 107.3m: the X chosen for the spell that became this permanent as it resolved (0 for any
// other entry). Its enters-the-battlefield triggered abilities use this X, though the
// permanent's own X is 0. Set one-shot from EntryInfo::x_paid.
DESIGNATION_OBJECT(int, entered_x, 0, entered_x, U16, "count", false, 0, u16_count(perm->entered_x))
// 701.37b: monstrous is a per-permanent designation with no rules meaning of its own — a
// marker the monstrosity action and "becomes monstrous" triggers identify. Once set it
// stays until the permanent leaves the battlefield (so it resets naturally when a new
// Permanent is created on re-entry). Internal state only — NOT exposed in the obs/state
// vector. Set by the Monstrosity$ resolution in effect_put_counter.cpp; read by the
// "NotMonstrous" activation gate (queries/activation.h). Mutated nowhere else.
DESIGNATION_OBJECT(bool, is_monstrous, false, monstrous, U8, "bool", false, 0, perm->is_monstrous)
// entered via its evoke alternate cost — fires the evoke sacrifice ETB trigger
DESIGNATION_OBJECT(bool, evoked, false, evoked, U8, "bool", false, 0, perm->evoked)
// This permanent entered because its spell was cast from the graveyard for its Escape cost
// (CR 702.139): the permanent "escaped". Read by the Card.Self+escaped present condition
// (Uro's "sacrifice it unless it escaped" ETB). Set when the Permanent is created from a
// spell cast with escape; false for a normal hand cast or any non-escape entry. General —
// reusable by any escape card with an "if it escaped" clause.
DESIGNATION_OBJECT(bool, cast_with_escape, false, escaped, U8, "bool", false, 0, perm->cast_with_escape)
// This permanent was returned to the battlefield by its Unearth ability (CR 702.84). While
// set: it gained haste on entry, a delayed triggered ability exiles it at the beginning of the
// next end step (CR 603.7b), and a leaves-the-battlefield replacement exiles it instead of
// letting it go anywhere else (the redirect in Orderer::add_to_zone). Set when the Permanent is
// created from a card whose unearth ChangeZone resolved (EntryInfo::unearthed); a fresh
// re-entry by any other means leaves it false.
DESIGNATION_OBJECT(bool, unearthed, false, unearthed, U8, "bool", false, 0, perm->unearthed)
// This permanent entered the battlefield as a spell its controller cast from their own
// hand (CR 601 — a normal hand cast). Read by the Card.wasCastFromYourHandByYou condition
// (Amped Raptor's dig-from-hand gate). Set when its Permanent is created from a spell that
// was cast from the hand; false for permanents put onto the battlefield any other way
// (reanimation, tokens, ChangeZone-to-battlefield, casts from exile/graveyard, etc.).
DESIGNATION_OBJECT(bool, cast_from_hand_by_controller, false, cast_from_hand, U8, "bool", false, 0,
                   perm->cast_from_hand_by_controller)
// Permanent::cast_mana_paid, kept only for a card that reads it, so that it is kept says which card.
DESIGNATION_OBJECT_COLUMN(spent_w, U8, "count", true, 0, u8_count(static_cast<int64_t>(mana_of_color(perm->cast_mana_paid, WHITE))))
DESIGNATION_OBJECT_COLUMN(spent_u, U8, "count", true, 0, u8_count(static_cast<int64_t>(mana_of_color(perm->cast_mana_paid, BLUE))))
DESIGNATION_OBJECT_COLUMN(spent_b, U8, "count", true, 0, u8_count(static_cast<int64_t>(mana_of_color(perm->cast_mana_paid, BLACK))))
DESIGNATION_OBJECT_COLUMN(spent_r, U8, "count", true, 0, u8_count(static_cast<int64_t>(mana_of_color(perm->cast_mana_paid, RED))))
DESIGNATION_OBJECT_COLUMN(spent_g, U8, "count", true, 0, u8_count(static_cast<int64_t>(mana_of_color(perm->cast_mana_paid, GREEN))))
// Who exerted it (CR 701.43): it won't untap during that player's next untap step.
DESIGNATION_OBJECT(Zone::Ownership, exerted_by, Zone::UNKNOWN, exerted, U8, "bool", false, 0,
                   perm->exerted_by != Zone::UNKNOWN)
// Permanent::overlay, the one of its rows that keeps a permanent's spell (CR 702.103b).
DESIGNATION_OBJECT_COLUMN(bestowed, U8, "bool", false, 0, perm->overlay == SpellOverlay::BESTOW)
// the prepared designation (CR 722.3a)
DESIGNATION_OBJECT(bool, prepared, false, prepared, U8, "bool", false, 0, perm->prepared)
// color chosen on ETB (Painter's Servant) — what AddColor$ ChosenColor adds. 1 + its `color` enum value; 0 none.
DESIGNATION_OBJECT(Colors, chosen_color, NO_COLOR, chosen_color, U8, "count", true, 0,
                   perm->chosen_color != NO_COLOR ? 1 + static_cast<uint64_t>(perm->chosen_color) : 0)
// Permanent::attacked_on_turn, read through attacked_this_turn.
DESIGNATION_OBJECT_COLUMN(attacked, U8, "bool", false, 0, attacked_this_turn(*perm))

#undef DESIGNATION_TURN
#undef DESIGNATION_GAME_PLAYER
#undef DESIGNATION_PLAYER
#undef DESIGNATION_OBJECT
#undef DESIGNATION_OBJECT_COLUMN
