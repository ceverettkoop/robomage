# Codegen derived from gitignored/fetched card-script content — regenerated on every
# `make` (unconditional pygen target), so it is untracked to keep a machine's stale
# local scripts from committing stale matrices. The script-independent codegen
# (train/_enums.py, src/gen/archetypes_gen.h) stays tracked.
train/card_costs.py
train/card_props.py
src/gen/card_costs_gen.h
bin/resources/logs/**
src/classes/game.cpp
logs/**
train/.venv/**
train/.venv
train/__pycache__/**
**/__pycache__/**
train/logs/**
checkpoints/*.zip
replays/*.txt
train/checkpoints/*
*.ts.pt
.cache/*
bin/resources/tokenscripts/*.txt
resources/logs/*
train/analysis_out/*
bin/resources/decks/temp/*
.claude/settings.local.json
diag_draw_*.txt
obj/*/*.d
obj/*.d
train/replays/*
corpus/
# ...but the replay-regression corpus IS tracked (the CI replay tier diffs
# against it); without this exception new scenario files stay silently
# unstaged after a re-record.
!train/regression/corpus/
!train/regression/corpus/**

# ci_check.py transcript/draw-log output directory, and stray draw logs runner.py
# writes to cwd on a stall (ci_check relocates them into --out-dir).
ci_out/
draw_*.txt

# Game recordings (.rmrec) — recording subsystem removed; never commit these
train/recordings/

# AlphaZero self-play shards (Phase C artifacts) — regenerate, never commit
train/az_data/

# In-process AlphaZero actor binary (Phase D) — built by `make actor`
bin/az_actor

# Cached Scryfall card art for the PySide6 board (train/scryfall_cache.py) —
# downloaded on demand, never committed. Delete misses.json to retry lookups.
bin/resources/card_images/
train/az/*
